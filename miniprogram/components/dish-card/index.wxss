.dish-tap {
  position: relative;
  display: block;
  margin: 26rpx 0 38rpx;
}

/* 覆盖 .paper 的内边距：封面要贴边 */
.dish-tap .dish-card {
  padding: 0;
  overflow: hidden;
}

/* 封面为空时的 CSS 占位图块 */
.cover {
  position: relative;
  width: 100%;
  height: 320rpx;
  background-color: var(--line);
}

.cover-img {
  display: block;
  width: 100%;
  height: 320rpx;
}

.cover-blank {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 320rpx;
  background-image: repeating-linear-gradient(
    45deg,
    rgba(138, 123, 109, 0.12) 0,
    rgba(138, 123, 109, 0.12) 12rpx,
    transparent 12rpx,
    transparent 26rpx
  );
}

.cover-blank-mark {
  color: var(--ink-soft);
  font-size: 68rpx;
  letter-spacing: 8rpx;
  opacity: 0.55;
}

.body {
  padding: 24rpx 28rpx 28rpx;
}

.dish-name {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.dish-story {
  margin-top: 10rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
  line-height: 1.5;
}

.dish-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.dish-meta {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed var(--line);
}

.dish-meta-text {
  color: var(--sage);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

/* ---------- 提交人（头像 + 昵称） ---------- */
.dish-who {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}

/* 容器自带纯 CSS 圆形占位：头像没加载出来时露出的就是它 */
.dish-who-avatar {
  flex: 0 0 48rpx;
  width: 48rpx;
  height: 48rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  overflow: hidden;
  background-color: var(--accent-soft);
}

.dish-who-img {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.dish-who-name {
  color: var(--ink-soft);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

/* ---------- 卡片内操作条：馋 / ♥ / +（SPEC-v1.0.8 §3.8）
 * 状态由页面算好（_wanted / _liked / _order），组件只负责长相；
 * 颜色只走 CSS 变量与 rgba()，符号是 Unicode 文本字符，不用 emoji。
 * 卡片宽度有限，比原来页面上的 56rpx 收一档到 52rpx。
 * ---------- */
.card-acts {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.card-act {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 52rpx;
  height: 52rpx;
  margin-left: 12rpx;
  border: 2rpx solid transparent;
  border-radius: 999rpx;
}

.card-act-sym {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

/* 点菜：暖橙 */
.card-act-order {
  border-color: rgba(228, 100, 60, 0.34);
  background-color: var(--accent-soft);
  color: var(--accent);
}

/* 没有进行中的点菜单：置灰，点击只提示不进入下单链路 */
.card-act-order.is-off {
  border-color: var(--line);
  background-color: var(--line);
  color: var(--ink-soft);
  opacity: 0.6;
}

/* 点菜中 / 已加：实心高亮，短暂停留防连点 */
.card-act-order.is-busy,
.card-act-order.is-done {
  border-color: var(--accent);
  background-color: var(--accent);
  color: var(--card);
}

/* 喜欢：暖橙，已喜欢实心填充 */
.card-act-like {
  border-color: rgba(228, 100, 60, 0.30);
  background-color: var(--accent-soft);
  color: var(--accent);
}

.card-act-like.is-on {
  border-color: var(--accent);
  background-color: var(--accent);
  color: var(--card);
}

/* 想吃：抹茶绿，已想吃填充 */
.card-act-want {
  border-color: rgba(124, 154, 109, 0.34);
  background-color: rgba(124, 154, 109, 0.16);
  color: var(--sage);
}

.card-act-want.is-on {
  border-color: var(--sage);
  background-color: var(--sage);
  color: var(--card);
}

.card-act.is-busy {
  opacity: 0.6;
}

/* 已选中态：符号再加重一档（与原页面操作条一致） */
.card-act.is-on .card-act-sym {
  font-weight: 800;
}
