<!-- 谁点过这道菜：半透明遮罩 + 底部面板；遮罩与 × 都能关，面板吞掉点击 -->
<view wx:if="{{visible}}" class="sheet-mask" catchtap="onMaskTap" catchtouchmove="noop">
  <view class="sheet-panel" catchtap="noop">
    <view class="sheet-head">
      <text class="sheet-title">谁点过「{{dishName}}」</text>
      <text class="sheet-close" catchtap="onClose">×</text>
    </view>

    <scroll-view class="sheet-body" scroll-y>
      <view wx:if="{{loading}}" class="sheet-hint">加载中…</view>
      <view wx:elif="{{!people.length}}" class="sheet-hint">还没人点过这道菜</view>
      <block wx:else>
        <view wx:for="{{people}}" wx:key="key" class="person-row">
          <view class="person-avatar">
            <image
              wx:if="{{item.avatar && !item.broken}}"
              class="person-img"
              src="{{item.avatar}}"
              mode="aspectFill"
              data-index="{{index}}"
              binderror="onAvatarError"
            />
            <view wx:else class="person-fallback">{{item.initial}}</view>
          </view>
          <view class="person-main">
            <view class="person-name">{{item.nickname}}</view>
            <view wx:if="{{item.timeText}}" class="person-time">最近 {{item.timeText}}</view>
          </view>
          <view class="person-times">点过 {{item.timesText}} 次</view>
        </view>
      </block>
    </scroll-view>
  </view>
</view>
