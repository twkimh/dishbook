<view class="tabbar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item"
    hover-class="tab-shrink"
    hover-stay-time="60"
    data-index="{{index}}"
    bindtap="onTap"
  >
    <view class="icon icon-{{item.icon}} {{selected === index ? 'icon-on' : ''}}">
      <view class="icon-inner"></view>
    </view>
    <view class="tab-text {{selected === index ? 'tab-on' : ''}}">{{item.text}}</view>
  </view>
</view>
