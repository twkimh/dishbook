/* 裁剪页 · 全屏舞台 + 比例栏
 * 本文件不得出现十六进制颜色字面量，一律 var(--x) 或 rgba()。
 */

.crop-page {
  position: relative;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background-color: rgba(59, 48, 42, 1);
  color: var(--card);
}

/* ---------- 顶栏 ---------- */
.crop-topbar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 24rpx 4rpx;
}

.topbar-title {
  font-size: 30rpx;
  letter-spacing: 6rpx;
  color: rgba(255, 253, 248, 0.92);
}

.topbar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 150rpx;
  padding: 16rpx 26rpx;
  border-radius: var(--radius);
  font-size: 28rpx;
  transition: transform 160ms ease;
}

.topbar-cancel {
  color: rgba(255, 253, 248, 0.86);
  border: 2rpx solid rgba(255, 253, 248, 0.28);
}

.cancel-arrow {
  margin-right: 6rpx;
  font-size: 34rpx;
  line-height: 1;
}

.topbar-done {
  background-color: var(--accent);
  box-shadow: var(--shadow);
  color: var(--card);
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* ---------- 舞台 ---------- */
.stage {
  position: relative;
  flex: 1;
  margin: 16rpx 20rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background-color: rgba(34, 26, 22, 1);
}

/* 关键：transform-origin 0 0，导出公式依赖这个原点 */
.stage-img {
  position: absolute;
  left: 0;
  top: 0;
  transform-origin: 0 0;
}

.mask {
  position: absolute;
  background-color: rgba(59, 48, 42, 0.55);
  pointer-events: none;
}

/*
 * 裁剪框：box-sizing 为 border-box，保证 width/height 就是舞台像素范围，
 * 描边不吃掉尺寸，导出换算按 crop.width 直接算即可。
 */
.crop-box {
  position: absolute;
  box-sizing: border-box;
  border: 3rpx solid rgba(255, 253, 248, 0.92);
  border-radius: 6rpx;
}

/* ---------- 四角 L 形标记 ---------- */
.corner {
  position: absolute;
  width: 34rpx;
  height: 34rpx;
  border-color: var(--card);
  border-style: solid;
  border-width: 0;
}

.corner-tl {
  left: -3rpx;
  top: -3rpx;
  border-left-width: 8rpx;
  border-top-width: 8rpx;
  border-top-left-radius: 6rpx;
}

.corner-tr {
  right: -3rpx;
  top: -3rpx;
  border-right-width: 8rpx;
  border-top-width: 8rpx;
  border-top-right-radius: 6rpx;
}

.corner-bl {
  left: -3rpx;
  bottom: -3rpx;
  border-left-width: 8rpx;
  border-bottom-width: 8rpx;
  border-bottom-left-radius: 6rpx;
}

.corner-br {
  right: -3rpx;
  bottom: -3rpx;
  border-right-width: 8rpx;
  border-bottom-width: 8rpx;
  border-bottom-right-radius: 6rpx;
}

/* ---------- 拖动手柄（透明热区 + 暖橙小圆点） ---------- */
.handle {
  position: absolute;
  z-index: 3;
}

.handle::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 18rpx;
  height: 18rpx;
  margin: -9rpx 0 0 -9rpx;
  border-radius: 50%;
  background-color: var(--accent);
}

.handle-nw,
.handle-ne,
.handle-sw,
.handle-se {
  width: 80rpx;
  height: 80rpx;
}

.handle-nw {
  left: -40rpx;
  top: -40rpx;
}

.handle-ne {
  right: -40rpx;
  top: -40rpx;
}

.handle-sw {
  left: -40rpx;
  bottom: -40rpx;
}

.handle-se {
  right: -40rpx;
  bottom: -40rpx;
}

.handle-n,
.handle-s {
  left: 50%;
  width: 120rpx;
  height: 68rpx;
  margin-left: -60rpx;
}

.handle-n {
  top: -34rpx;
}

.handle-s {
  bottom: -34rpx;
}

.handle-w,
.handle-e {
  top: 50%;
  width: 68rpx;
  height: 120rpx;
  margin-top: -60rpx;
}

.handle-w {
  left: -34rpx;
}

.handle-e {
  right: -34rpx;
}

/* ---------- 加载态 / 提示 ---------- */
.stage-loading {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  margin-top: -20rpx;
  text-align: center;
  font-size: 26rpx;
  color: rgba(255, 253, 248, 0.72);
}

.stage-hint {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: rgba(255, 253, 248, 0.62);
}

.hint-zoom {
  font-weight: 600;
  color: var(--accent-soft);
}

/* ---------- 比例栏 ---------- */
.ratio-bar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx 40rpx;
}

.ratio-chip {
  box-sizing: border-box;
  padding: 12rpx 24rpx;
  border: 2rpx solid rgba(255, 253, 248, 0.24);
  border-radius: 999rpx;
  font-size: 26rpx;
  letter-spacing: 1rpx;
  color: rgba(255, 253, 248, 0.78);
  transition: transform 160ms ease, background-color 160ms ease;
}

.ratio-chip-on {
  border-color: var(--accent);
  background-color: var(--accent);
  color: var(--card);
  font-weight: 600;
}

/* ---------- 离屏 canvas：用定位移出可视区，不用 display:none ---------- */
.crop-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 2px;
  height: 2px;
}
