<view class="page mine-page">
  <view class="page-head">
    <view class="page-title">我的</view>
    <view class="page-sub">身份、主人家入口和我提交过的菜</view>
  </view>

  <!-- 身份卡片：头像走微信头像填写能力，昵称走 type="nickname" 自动填充 -->
  <view class="id-card paper tilt-l">
    <view class="tape tape-top"></view>
    <view class="id-row">
      <button
        class="avatar-btn tap"
        hover-class="tap-shrink"
        hover-stay-time="60"
        open-type="chooseAvatar"
        bindchooseavatar="onChooseAvatar"
      >
        <image
          wx:if="{{avatarUrl}}"
          class="avatar-img"
          src="{{avatarUrl}}"
          mode="aspectFill"
          binderror="onAvatarError"
        />
        <view wx:else class="avatar-empty">{{avatarText}}</view>
      </button>
      <view class="id-text">
        <view class="role-badge role-{{isOwner ? 'owner' : 'guest'}}">{{isOwner ? '主人家' : '访客'}}</view>
        <input
          type="nickname"
          class="nickname-input"
          value="{{nickname}}"
          maxlength="20"
          placeholder="怎么称呼你"
          placeholder-class="nickname-ph"
          bindinput="onNicknameInput"
          bindblur="onNicknameBlur"
        />
        <view class="id-hint">{{isOwner ? '这一摊是你管的：菜谱、审核、点菜记录' : '可以浏览菜谱，也能推荐一道菜等主人家审核'}}</view>
        <view class="avatar-hint">{{avatarUploading ? '头像正在上传…' : '点头像换头像'}}</view>
      </view>
    </view>
    <view class="edit-line tap" hover-class="tap-shrink" hover-stay-time="60" bindtap="onEditNickname">
      <text class="edit-text">修改我的称呼</text>
      <text class="edit-arrow">›</text>
    </view>
  </view>

  <!-- 主人家专属入口 -->
  <view wx:if="{{isOwner}}" class="entries">
    <view class="entry paper tilt-r tap" hover-class="tap-shrink" hover-stay-time="60" bindtap="goOrders">
      <view class="entry-main">
        <view class="entry-title">点菜记录</view>
        <view class="entry-sub">朋友想吃的菜都记在这儿</view>
      </view>
      <view class="entry-arrow">›</view>
    </view>
    <view class="entry paper tilt-l tap" hover-class="tap-shrink" hover-stay-time="60" bindtap="goReview">
      <view class="entry-main">
        <view class="entry-title">待审核</view>
        <view class="entry-sub">朋友推荐过来的菜</view>
      </view>
      <view wx:if="{{pendingCount > 0}}" class="badge">{{pendingText}}</view>
      <view class="entry-arrow">›</view>
    </view>
    <view class="entry paper tilt-r tap" hover-class="tap-shrink" hover-stay-time="60" bindtap="onNoticeTap">
      <view class="entry-main">
        <view class="entry-title">点菜提醒</view>
        <view class="entry-sub">{{noticeHint}}</view>
      </view>
      <view class="entry-arrow">›</view>
    </view>
    <view class="entry paper tilt-l tap" hover-class="tap-shrink" hover-stay-time="60" bindtap="goRecycle">
      <view class="entry-main">
        <view class="entry-title">回收站</view>
        <view class="entry-sub">删掉的菜和点菜单，30 天内能找回</view>
      </view>
      <view class="entry-arrow">›</view>
    </view>
  </view>

  <!-- 我的申请：只给非主人家看。主人家删菜是直接生效的，永远不会产生申请记录，
       这个入口对他永远是空的，属于噪音。tilt 跟上面的身份卡（tilt-l）交替 -->
  <view wx:if="{{!isOwner}}" class="entries">
    <view class="entry paper tilt-r tap" hover-class="tap-shrink" hover-stay-time="60" bindtap="goMyDeletes">
      <view class="entry-main">
        <view class="entry-title">我的申请</view>
        <view class="entry-sub">看看申请通过了没有</view>
      </view>
      <view class="entry-arrow">›</view>
    </view>
  </view>

  <!-- 我的提交 -->
  <view class="section-head">
    <text class="section-title">我的提交</text>
    <text class="section-count">{{total}} 道</text>
  </view>

  <block wx:if="{{skeleton}}">
    <view class="row paper">
      <view class="skeleton skeleton-line skeleton-cover"></view>
      <view class="row-body">
        <view class="skeleton skeleton-line skeleton-title"></view>
        <view class="skeleton skeleton-line skeleton-sub"></view>
      </view>
    </view>
    <view class="row paper tilt-r">
      <view class="skeleton skeleton-line skeleton-cover"></view>
      <view class="row-body">
        <view class="skeleton skeleton-line skeleton-title"></view>
        <view class="skeleton skeleton-line skeleton-sub"></view>
      </view>
    </view>
  </block>

  <block wx:elif="{{list.length}}">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="row paper {{index % 2 === 0 ? 'tilt-l' : 'tilt-r'}}"
      data-id="{{item.id}}"
      bindtap="goDish"
    >
      <view class="row-cover">
        <image wx:if="{{item.cover}}" class="row-img" src="{{item.cover}}" mode="aspectFill" lazy-load />
        <view wx:else class="row-blank"><text class="row-mark">菜</text></view>
      </view>
      <view class="row-body">
        <view class="row-top">
          <text class="row-name">{{item.name}}</text>
          <text class="status status-{{item.status}}">{{item.statusText}}</text>
        </view>
        <view class="row-foot">
          <text class="row-time">{{item.timeText}}</text>
          <!-- 删除：与自己传的菜同一套规则——主人家直接进回收站，其他人填理由等审核。
               catchtap 阻止冒泡，否则会连带触发整行的 goDish -->
          <view
            class="row-del tap"
            hover-class="tap-shrink"
            hover-stay-time="60"
            data-id="{{item.id}}"
            data-name="{{item.name}}"
            catchtap="onDeleteDish"
          >删除</view>
        </view>
      </view>
    </view>

    <view wx:if="{{loadingMore}}" class="foot-hint">正在加载更多…</view>
    <view wx:elif="{{!hasMore}}" class="foot-hint">没有更多了</view>
  </block>

  <empty-state wx:elif="{{!loading}}" text="还没有提交过菜" hint="去「加菜」页把做过的菜记下来" />

  <!-- 菜单球（悬浮入口，组件无 props，SPEC-v1.0.8） -->
  <menu-ball />
</view>
