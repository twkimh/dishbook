/* 我的页面（tab 页，底部留给 custom-tab-bar）
 * 只允许 var(--x) 与 rgba()，不出现颜色字面量。
 */

.mine-page .page-head {
  margin-bottom: 24rpx;
}

/* ---------- 身份卡片 ---------- */
.id-card {
  margin-bottom: 28rpx;
  padding: 28rpx;
}

.id-row {
  display: flex;
  align-items: center;
}

/* ---------- 头像（72rpx 圆，纯 CSS 占位，无图片素材） ---------- */
.avatar-btn {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  overflow: hidden;
  border: 2rpx dashed var(--line);
  border-radius: 50%;
  background-color: rgba(234, 223, 203, 0.55);
  line-height: 1;
}

/* 去掉 button 自带的伪元素边框与背景 */
.avatar-btn::after {
  border: none;
}

.avatar-img {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background-color: var(--accent-soft);
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
}

.avatar-hint {
  margin-top: 6rpx;
  color: var(--ink-soft);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

/* ---------- 昵称输入（type="nickname"） ---------- */
.nickname-input {
  min-height: 44rpx;
  margin-top: 6rpx;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.nickname-ph {
  color: var(--ink-soft);
  font-weight: 400;
  letter-spacing: 1rpx;
}

.role-badge {
  flex: 0 0 auto;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.role-owner {
  background-color: var(--accent);
  color: var(--card);
}

.role-guest {
  background-color: var(--accent-soft);
  color: var(--ink);
}

.id-text {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.id-name {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.id-hint {
  margin-top: 8rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
  line-height: 1.5;
}

.edit-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed var(--line);
}

.edit-text {
  color: var(--accent);
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

.edit-arrow {
  color: var(--accent);
  font-size: 32rpx;
  line-height: 1;
}

/* ---------- 主人家入口 ---------- */
.entries {
  margin-bottom: 12rpx;
}

.entry {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 26rpx 28rpx;
}

.entry-main {
  flex: 1;
  min-width: 0;
}

.entry-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.entry-sub {
  margin-top: 6rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
}

.badge {
  flex: 0 0 auto;
  min-width: 40rpx;
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background-color: var(--accent);
  color: var(--card);
  font-size: 20rpx;
  line-height: 1.5;
  text-align: center;
}

.entry-arrow {
  margin-left: 16rpx;
  color: var(--ink-soft);
  font-size: 32rpx;
  line-height: 1;
}

/* ---------- 我的提交 ---------- */
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 36rpx 0 20rpx;
}

.section-title {
  position: relative;
  padding-bottom: 10rpx;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.section-title::after {
  content: '';
  position: absolute;
  left: 0;
  right: 20rpx;
  bottom: 0;
  height: 6rpx;
  border-radius: 6rpx;
  background-color: var(--accent-soft);
}

.section-count {
  color: var(--ink-soft);
  font-size: 22rpx;
}

.row {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
  padding: 20rpx 24rpx;
}

.row-cover {
  flex: 0 0 120rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background-color: rgba(234, 223, 203, 0.45);
}

.row-img {
  width: 100%;
  height: 100%;
}

.row-blank {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.row-mark {
  color: var(--ink-soft);
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.row-body {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.row-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-name {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status {
  flex: 0 0 auto;
  margin-left: 14rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.status-approved {
  background-color: rgba(124, 154, 109, 0.20);
  color: var(--sage);
}

.status-pending {
  background-color: rgba(232, 180, 74, 0.26);
  color: var(--ink);
}

.status-rejected {
  background-color: var(--accent-soft);
  color: var(--accent);
}

.row-time {
  margin-top: 10rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
}

/* ---------- 骨架 ---------- */
.skeleton-cover {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 0;
}

.skeleton-title {
  width: 55%;
}

.skeleton-sub {
  width: 35%;
  margin-bottom: 0;
}

/* ---------- 底部提示 ---------- */
.foot-hint {
  padding: 16rpx 0 40rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
  text-align: center;
  letter-spacing: 1rpx;
}
