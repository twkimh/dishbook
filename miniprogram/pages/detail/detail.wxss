/* 详情页专属样式：非 tab 页，但底部有点菜按钮，需要留出空间
 * 只允许 var(--x) 与 rgba()，不写颜色字面量（SPEC §5）
 */

.detail-page {
  padding-bottom: 260rpx;
}

/* ---------- 封面 ---------- */
.cover-block {
  position: relative;
  margin-bottom: 36rpx;
}

.cover-wrap {
  padding: 0;
  overflow: hidden;
  background-color: var(--line);
}

/* 定高 = 定宽高比（宽度由页面撑满），加载前后不跳动 */
.cover-img {
  display: block;
  width: 100%;
  height: 520rpx;
}

.cover-blank {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 520rpx;
  background-image: repeating-linear-gradient(
    45deg,
    rgba(138, 123, 109, 0.12) 0,
    rgba(138, 123, 109, 0.12) 12rpx,
    transparent 12rpx,
    transparent 26rpx
  );
}

.cover-blank-mark {
  color: var(--ink-soft);
  font-size: 26rpx;
  letter-spacing: 4rpx;
  opacity: 0.7;
}

/* ---------- 标题 / 标签 / 说明 ---------- */
.detail-head {
  margin-bottom: 20rpx;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
}

.detail-story {
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  border-left: 6rpx solid var(--accent-soft);
  border-radius: 0 var(--radius) var(--radius) 0;
  background-color: var(--card);
  color: var(--ink-soft);
  font-size: 27rpx;
  line-height: 1.7;
  letter-spacing: 1rpx;
  word-break: break-word;
}

.detail-dashed {
  margin: 30rpx 0 26rpx;
}

/* ---------- 数据条 ---------- */
.detail-meta {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.meta-item {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.meta-value {
  color: var(--accent);
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.meta-value-sm {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.meta-label {
  margin-top: 6rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

/* ---------- 底部固定点菜按钮 ---------- */
.order-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  box-sizing: border-box;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 2rpx dashed var(--line);
  background-color: var(--paper);
  background-image: radial-gradient(rgba(90, 62, 40, 0.04) 1rpx, transparent 1rpx);
  background-size: 22rpx 22rpx;
}

/* 点菜中 / 已点：降饱和，配合 hover-class 关闭避免误以为可点 */
.order-btn-busy {
  background-color: var(--accent-soft);
  color: var(--ink-soft);
  box-shadow: none;
}

/* ---------- 加载骨架 ---------- */
.detail-cover-skeleton {
  height: 520rpx;
  margin-bottom: 36rpx;
}

.skeleton-line-title {
  width: 46%;
  height: 40rpx;
  margin-bottom: 24rpx;
}

.skeleton-line-short {
  width: 62%;
  margin-bottom: 0;
}
