<view class="page index-page">
  <view class="page-head">
    <view class="page-title">今日菜谱</view>
    <view class="page-sub">主人家做过的菜，都会收在这里</view>
  </view>

  <!-- 搜索框：输入后 300ms 防抖再请求 -->
  <view class="search paper">
    <view class="search-icon"></view>
    <input
      class="search-input"
      type="text"
      value="{{keyword}}"
      placeholder="搜一道菜的名字"
      placeholder-class="search-placeholder"
      confirm-type="search"
      bindinput="onKeywordInput"
      bindconfirm="onKeywordConfirm"
    />
    <view
      wx:if="{{keyword}}"
      class="search-clear tap"
      hover-class="tap-shrink"
      hover-stay-time="60"
      catchtap="onClearKeyword"
    >清空</view>
  </view>

  <!-- 标签筛选条：横向滚动，点选过滤，再点取消 -->
  <scroll-view wx:if="{{tags.length}}" class="tag-bar" scroll-x>
    <view class="tag-bar-track">
      <view
        wx:for="{{tags}}"
        wx:key="*this"
        class="tag-option tap {{activeTag === item ? 'tag-option-on' : ''}}"
        hover-class="tap-shrink"
        hover-stay-time="60"
        data-tag="{{item}}"
        bindtap="onTagTap"
      >{{item}}</view>
    </view>
  </scroll-view>

  <!-- 首屏骨架 -->
  <view wx:if="{{firstLoading && !list.length}}" class="grid">
    <view class="column">
      <view class="skeleton-card" wx:for="{{[0, 1]}}" wx:key="*this">
        <view class="skeleton skeleton-cover"></view>
        <view class="skeleton-body">
          <view class="skeleton-line"></view>
          <view class="skeleton-line skeleton-line-short"></view>
        </view>
      </view>
    </view>
    <view class="column">
      <view class="skeleton-card" wx:for="{{[0, 1]}}" wx:key="*this">
        <view class="skeleton skeleton-cover"></view>
        <view class="skeleton-body">
          <view class="skeleton-line"></view>
          <view class="skeleton-line skeleton-line-short"></view>
        </view>
      </view>
    </view>
  </view>

  <view wx:elif="{{list.length}}" class="grid">
    <!-- 两列瀑布：index 交给 dish-card，用于相邻卡片交替倾斜。
         三个操作按钮已经在 dish-card 内部，.cell 只负责列宽。 -->
    <view class="column">
      <view wx:for="{{leftColumn}}" wx:key="_id" class="cell">
        <dish-card
          dish="{{item}}"
          index="{{index * 2}}"
          menu-ready="{{menuReady}}"
          bindtap="onCardTap"
          bind:order="onCardOrder"
          bind:like="onCardLike"
          bind:want="onCardWant"
          bind:orderers="onCardOrderers"
        />
      </view>
    </view>
    <view class="column">
      <view wx:for="{{rightColumn}}" wx:key="_id" class="cell">
        <dish-card
          dish="{{item}}"
          index="{{index * 2 + 1}}"
          menu-ready="{{menuReady}}"
          bindtap="onCardTap"
          bind:order="onCardOrder"
          bind:like="onCardLike"
          bind:want="onCardWant"
          bind:orderers="onCardOrderers"
        />
      </view>
    </view>
  </view>

  <empty-state wx:else text="{{emptyText}}" hint="{{emptyHint}}" />

  <!-- 触底状态 -->
  <view wx:if="{{list.length}}" class="list-foot">
    <view wx:if="{{loadingMore}}" class="foot-text">正在往下翻…</view>
    <view wx:elif="{{endReached}}" class="foot-text foot-end">到底啦</view>
  </view>

  <!-- 首次进入引导：补头像昵称（可跳过）。遮罩不响应关闭，只有两个按钮能关 -->
  <view wx:if="{{guideVisible}}" class="guide-mask" catchtap="onGuideMaskTap">
    <view class="guide-card paper tilt-l">
      <view class="tape tape-top"></view>
      <view class="guide-title">让主人家认出你</view>
      <view class="guide-sub">留个称呼、选个头像，点菜的时候主人家就知道是谁啦</view>
      <button
        class="guide-avatar tap"
        hover-class="tap-shrink"
        hover-stay-time="60"
        open-type="chooseAvatar"
        bindchooseavatar="onGuideChooseAvatar"
      >
        <image
          wx:if="{{guideAvatarUrl}}"
          class="guide-avatar-img"
          src="{{guideAvatarUrl}}"
          mode="aspectFill"
          binderror="onGuideAvatarError"
        />
        <view wx:else class="guide-avatar-empty">点头像</view>
      </button>
      <input
        type="nickname"
        class="guide-nickname"
        value="{{guideNickname}}"
        maxlength="20"
        placeholder="怎么称呼你"
        placeholder-class="guide-ph"
        bindinput="onGuideNicknameInput"
      />
      <view class="guide-actions">
        <view
          class="sketch-btn sketch-btn-ghost guide-btn"
          hover-class="tap-shrink"
          hover-stay-time="60"
          bindtap="onGuideSkip"
        >稍后再说</view>
        <view
          class="sketch-btn guide-btn guide-btn-main {{guideSaving ? 'is-busy' : ''}}"
          hover-class="tap-shrink"
          hover-stay-time="60"
          bindtap="onGuideSave"
        >{{guideSaving ? '保存中…' : '保存'}}</view>
      </view>
    </view>
  </view>

  <!-- 菜单球（悬浮入口，组件无 props，SPEC-v1.0.8） -->
  <menu-ball />

  <!-- 谁点过这道菜：挂页面根节点（不能进带 transform 的 .paper），组件自己拉数据 -->
  <orderers-sheet
    visible="{{orderersVisible}}"
    dish-id="{{orderersDishId}}"
    dish-name="{{orderersDishName}}"
    bind:close="onOrderersClose"
  />
</view>
