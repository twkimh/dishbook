/* 菜品流页面专属样式：只允许 var(--x) 与 rgba()，不写颜色字面量（SPEC §5） */

.index-page .page-head {
  padding-top: 12rpx;
}

/* ---------- 搜索框 ---------- */
.search {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
}

/* 放大镜：纯 CSS 圆圈 + 斜把手 */
.search-icon {
  position: relative;
  flex: none;
  width: 24rpx;
  height: 24rpx;
  margin-right: 18rpx;
  border: 3rpx solid var(--ink-soft);
  border-radius: 50%;
  opacity: 0.8;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: -10rpx;
  bottom: -6rpx;
  width: 12rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background-color: var(--ink-soft);
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 48rpx;
  color: var(--ink);
  font-size: 28rpx;
  letter-spacing: 1rpx;
}

.search-placeholder {
  color: var(--ink-soft);
  font-size: 26rpx;
}

.search-clear {
  flex: none;
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  border: 2rpx dashed var(--line);
  color: var(--ink-soft);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

/* ---------- 标签筛选条（横向滚动） ---------- */
.tag-bar {
  width: 100%;
  margin: 18rpx 0 0;
  white-space: nowrap;
}

.tag-bar-track {
  display: inline-block;
  padding: 2rpx 0 8rpx;
}

.tag-option {
  display: inline-block;
  margin-right: 14rpx;
  padding: 8rpx 24rpx;
  border: 2rpx dashed var(--line);
  border-radius: 999rpx;
  background-color: var(--card);
  color: var(--ink-soft);
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

/* 选中态：实线暖橙描边 + 浅橙底，和未选中一眼可分 */
.tag-option-on {
  border-style: solid;
  border-color: var(--accent);
  background-color: var(--accent-soft);
  color: var(--ink);
  font-weight: 600;
}

/* ---------- 两列瀑布 ---------- */
.grid {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  width: 100%;
}

/* 定宽而不是 flex:1，配合 space-between 得到稳定的两列 + 列间距 */
.column {
  width: 48.8%;
  min-width: 0;
  box-sizing: border-box;
  /* 长菜名/长标签在窄列里折行，不撑破列宽 */
  word-break: break-word;
  overflow-wrap: break-word;
}

/* ---------- 首屏骨架 ---------- */
.skeleton-card {
  margin: 26rpx 0 38rpx;
  overflow: hidden;
  border-radius: var(--radius);
  background-color: var(--card);
  box-shadow: var(--shadow);
}

/* 与 dish-card 的封面同高，骨架切到真实卡片时不跳动 */
.skeleton-cover {
  height: 320rpx;
  border-radius: 0;
}

.skeleton-body {
  padding: 24rpx 24rpx 28rpx;
}

.skeleton-line-short {
  width: 58%;
  margin-bottom: 0;
}

/* ---------- 触底 / 到底 ---------- */
.list-foot {
  padding: 16rpx 0 8rpx;
  text-align: center;
}

.foot-text {
  color: var(--ink-soft);
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.foot-end {
  position: relative;
  display: inline-block;
  padding: 6rpx 28rpx;
  border: 2rpx dashed var(--line);
  border-radius: 999rpx;
}

/* ---------- 首次进入引导浮层（可跳过）
 * 半透明遮罩盖住整屏，只有卡片里的两个按钮能关；
 * 卡片居中，不会被底部 tabBar 压住。
 * ---------- */
.guide-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 48rpx;
  background-color: rgba(59, 48, 42, 0.45);
}

.guide-card {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  width: 100%;
  max-width: 560rpx;
  padding: 44rpx 36rpx 36rpx;
  text-align: center;
}

.guide-title {
  color: var(--ink);
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.guide-sub {
  margin-top: 10rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  line-height: 1.5;
}

.guide-avatar {
  width: 140rpx;
  height: 140rpx;
  margin: 28rpx auto 0;
  padding: 0;
  overflow: hidden;
  border: 2rpx dashed var(--line);
  border-radius: 50%;
  background-color: rgba(234, 223, 203, 0.55);
  line-height: 1;
}

/* 去掉 button 自带的边框与背景 */
.guide-avatar::after {
  border: none;
}

.guide-avatar-img {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.guide-avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background-color: var(--accent-soft);
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.guide-nickname {
  box-sizing: border-box;
  width: 100%;
  margin-top: 28rpx;
  padding: 16rpx 24rpx;
  border: 2rpx dashed var(--line);
  border-radius: var(--radius);
  background-color: var(--card);
  color: var(--ink);
  font-size: 28rpx;
  text-align: center;
}

.guide-ph {
  color: var(--ink-soft);
  font-size: 26rpx;
}

.guide-actions {
  display: flex;
  margin-top: 32rpx;
}

.guide-btn {
  flex: 1;
  padding: 20rpx 0;
  font-size: 28rpx;
}

.guide-btn-main {
  margin-left: 20rpx;
}

.is-busy {
  opacity: 0.6;
}
