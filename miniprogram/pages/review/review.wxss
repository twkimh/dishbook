/* 待审核页（非 tab 页，底部不需要给 tabBar 留空）
 * 只允许 var(--x) 与 rgba()，不出现颜色字面量。
 */

.review-page {
  padding-bottom: 120rpx;
}

.review-page .page-head {
  margin-bottom: 20rpx;
}

/* ---------- 分类切换 ---------- */
.mode-bar {
  display: flex;
  margin-bottom: 24rpx;
}

.mode-chip {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin-right: 16rpx;
  padding: 18rpx 20rpx;
  border: 2rpx dashed var(--line);
  border-radius: 999rpx;
  background-color: rgba(255, 253, 248, 0.55);
}

.mode-chip:last-child {
  margin-right: 0;
}

/* 选中态：暖橙虚线 + 浅橙底，不用系统高亮 */
.mode-chip.is-on {
  border-color: var(--accent);
  background-color: var(--accent-soft);
}

.mode-text {
  color: var(--ink-soft);
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.mode-chip.is-on .mode-text {
  color: var(--ink);
  font-weight: 600;
}

.mode-num {
  min-width: 34rpx;
  margin-left: 10rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background-color: rgba(90, 62, 40, 0.10);
  color: var(--ink-soft);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
}

.mode-chip.is-on .mode-num {
  background-color: var(--accent);
  color: var(--card);
}

/* ---------- 计数 ---------- */
.count-bar {
  display: flex;
  align-items: baseline;
  margin-bottom: 28rpx;
  padding: 22rpx 28rpx;
}

.count-num {
  color: var(--accent);
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.count-text {
  margin-left: 12rpx;
  color: var(--ink);
  font-size: 26rpx;
}

/* ---------- 卡片 ---------- */
.card {
  margin-bottom: 30rpx;
  padding: 24rpx;
}

.cover-wrap {
  height: 300rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background-color: rgba(234, 223, 203, 0.45);
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-blank {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.cover-mark {
  color: var(--ink-soft);
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.dish-name {
  margin-top: 20rpx;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
}

/* 提交人头像：48rpx 圆，取不到就落到纯 CSS 占位 */
.who-avatar {
  flex: 0 0 48rpx;
  width: 48rpx;
  height: 48rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background-color: rgba(234, 223, 203, 0.75);
}

.who-avatar-blank {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background-color: var(--accent-soft);
  color: var(--ink);
  font-size: 22rpx;
  font-weight: 600;
}

.who {
  flex: 0 1 auto;
  min-width: 0;
  color: var(--ink);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 用户编号：openid 后 6 位，只做区分，不抢视觉 */
.user-tag {
  flex: 0 0 auto;
  margin-left: 10rpx;
  color: var(--ink-soft);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.dot {
  margin: 0 10rpx;
}

.story {
  margin-top: 14rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  line-height: 1.6;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

/* ---------- 修改提案 ---------- */
.proposal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.proposal-name {
  flex: 0 1 auto;
  min-width: 0;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 「修改」小标签：芥末黄描边，和「新菜」区分开 */
.proposal-badge {
  flex: 0 0 auto;
  margin-left: 16rpx;
  padding: 2rpx 16rpx;
  border: 2rpx solid var(--mustard);
  border-radius: 999rpx;
  color: var(--ink);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

/* 摘要：四行小字，标签定宽，值换行不撑破卡片 */
.summary {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-left: 4rpx solid var(--accent-soft);
  border-radius: 12rpx;
  background-color: rgba(248, 211, 188, 0.22);
}

.summary-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.summary-row:last-child {
  margin-bottom: 0;
}

.summary-label {
  flex: 0 0 64rpx;
  margin-right: 12rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
  line-height: 1.5;
  letter-spacing: 1rpx;
}

.summary-value {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-size: 22rpx;
  line-height: 1.5;
  word-break: break-all;
}

/* ---------- 操作 ---------- */
.actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed var(--line);
}

.btn {
  margin-left: 16rpx;
  padding: 14rpx 42rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.btn-pass {
  background-color: var(--sage);
  color: var(--card);
  font-weight: 600;
}

.btn-reject {
  border: 2rpx dashed var(--accent-soft);
  background-color: transparent;
  color: var(--accent);
}

.is-busy {
  opacity: 0.6;
}

/* ---------- 骨架 ---------- */
.skeleton-cover {
  height: 300rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.skeleton-title {
  width: 55%;
}

.skeleton-sub {
  width: 35%;
  margin-bottom: 0;
}

/* ---------- 底部提示 ---------- */
.foot-hint {
  padding: 20rpx 0 40rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
  text-align: center;
  letter-spacing: 1rpx;
}
