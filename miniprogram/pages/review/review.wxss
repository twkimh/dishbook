/* 待审核页（非 tab 页，底部不需要给 tabBar 留空）
 * 只允许 var(--x) 与 rgba()，不出现颜色字面量。
 */

.review-page {
  padding-bottom: 120rpx;
}

.review-page .page-head {
  margin-bottom: 20rpx;
}

/* ---------- 计数 ---------- */
.count-bar {
  display: flex;
  align-items: baseline;
  margin-bottom: 28rpx;
  padding: 22rpx 28rpx;
}

.count-num {
  color: var(--accent);
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.count-text {
  margin-left: 12rpx;
  color: var(--ink);
  font-size: 26rpx;
}

/* ---------- 卡片 ---------- */
.card {
  margin-bottom: 30rpx;
  padding: 24rpx;
}

.cover-wrap {
  height: 300rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background-color: rgba(234, 223, 203, 0.45);
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-blank {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.cover-mark {
  color: var(--ink-soft);
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.dish-name {
  margin-top: 20rpx;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
}

/* 提交人头像：48rpx 圆，取不到就落到纯 CSS 占位 */
.who-avatar {
  flex: 0 0 48rpx;
  width: 48rpx;
  height: 48rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background-color: rgba(234, 223, 203, 0.75);
}

.who-avatar-blank {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background-color: var(--accent-soft);
  color: var(--ink);
  font-size: 22rpx;
  font-weight: 600;
}

.who {
  color: var(--ink);
  font-weight: 600;
}

.dot {
  margin: 0 10rpx;
}

.story {
  margin-top: 14rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  line-height: 1.6;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

/* ---------- 操作 ---------- */
.actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed var(--line);
}

.btn {
  margin-left: 16rpx;
  padding: 14rpx 42rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.btn-pass {
  background-color: var(--sage);
  color: var(--card);
  font-weight: 600;
}

.btn-reject {
  border: 2rpx dashed var(--accent-soft);
  background-color: transparent;
  color: var(--accent);
}

.is-busy {
  opacity: 0.6;
}

/* ---------- 骨架 ---------- */
.skeleton-cover {
  height: 300rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.skeleton-title {
  width: 55%;
}

.skeleton-sub {
  width: 35%;
  margin-bottom: 0;
}

/* ---------- 底部提示 ---------- */
.foot-hint {
  padding: 20rpx 0 40rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
  text-align: center;
  letter-spacing: 1rpx;
}
