/* 点菜单页（v1.0.8）
 * 只允许 var(--x) 与 rgba()，不出现颜色字面量。
 */

.menu-page {
  padding-bottom: 200rpx;
}

/* ---------- 顶部状态 ---------- */
.status-card {
  margin-bottom: 24rpx;
  padding: 26rpx 28rpx;
}

.status-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-title {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-badge {
  flex: 0 0 auto;
  margin-left: 16rpx;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background-color: rgba(124, 154, 109, 0.22);
  color: var(--sage);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.status-meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
}

.meta-item {
  flex: 0 1 auto;
  min-width: 0;
}

.meta-dot {
  margin: 0 10rpx;
}

.status-foot {
  display: flex;
  align-items: baseline;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed var(--line);
}

.remain-label {
  color: var(--ink-soft);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.remain-value {
  margin-left: 14rpx;
  color: var(--accent);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.status-empty {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-align: center;
  padding: 20rpx 0 8rpx;
}

.status-hint {
  margin-top: 8rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
  text-align: center;
  letter-spacing: 1rpx;
}

/* 已结束 / 已确认的徽标：比「点菜中」的抹茶绿退一档 */
.status-badge-off {
  background-color: rgba(138, 123, 109, 0.14);
  color: var(--ink-soft);
}

/* ---------- 页眉右侧的「待确认」小入口（§4）：只是几个字，没有底色/边框/阴影 ---------- */
.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.review-link {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  margin-left: 16rpx;
  padding: 4rpx 2rpx;
}

.review-link-text {
  font-size: 24rpx;
  color: var(--ink-soft);
  letter-spacing: 1rpx;
}

/* 唯一的强调点：未确认轮次的数字 */
.review-link-badge {
  margin-left: 6rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background-color: var(--accent);
  color: var(--card);
  font-size: 20rpx;
}

.review-link-arrow {
  margin-left: 4rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
}

/* review 视图的空状态：没有待确认轮次时停在这里，等用户自己返回 */
.review-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 70rpx 28rpx;
}

.review-empty-text {
  color: var(--ink-soft);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-align: center;
}

.review-empty-hint {
  margin-top: 12rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
  letter-spacing: 1rpx;
  text-align: center;
}

/* review 视图顶部的返回入口 */
.review-back {
  display: inline-block;
  margin: 4rpx 0 22rpx;
  padding: 8rpx 22rpx;
  border: 2rpx dashed var(--accent);
  border-radius: 999rpx;
  color: var(--accent);
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

/* ---------- 待确认提示（§4） ---------- */
.review-callout {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border: 2rpx dashed var(--accent);
  border-radius: var(--radius);
  background-color: var(--accent-soft);
}

.callout-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.callout-text {
  margin-top: 8rpx;
  color: var(--ink);
  font-size: 24rpx;
  line-height: 1.5;
  letter-spacing: 1rpx;
}

/* ---------- 逐菜确认：已做 / 未做 ---------- */
.decide-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 2rpx dashed var(--line);
}

.decide-chip {
  margin-right: 16rpx;
  padding: 8rpx 26rpx;
  border: 2rpx dashed var(--line);
  border-radius: 999rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.decide-on {
  border-style: solid;
  border-color: var(--accent);
  background-color: var(--accent-soft);
  color: var(--ink);
  font-weight: 600;
}

.decide-off {
  border-style: solid;
  border-color: var(--ink-soft);
  background-color: rgba(138, 123, 109, 0.16);
  color: var(--ink);
  font-weight: 600;
}

/* 确认后的只读徽标：已做走 accent 系，未做走 ink-soft 系 */
.mark-badge {
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.mark-done {
  background-color: rgba(228, 100, 60, 0.16);
  color: var(--accent);
  font-weight: 600;
}

.mark-missed {
  background-color: rgba(138, 123, 109, 0.14);
  color: var(--ink-soft);
}

.confirm-bar {
  margin: 6rpx 0 26rpx;
}

/* ---------- 主人家控制区 ---------- */
.owner-bar {
  margin-bottom: 28rpx;
}

/* ---------- 历史返回条 ---------- */
.history-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 18rpx 24rpx;
  background-color: var(--accent-soft);
}

.banner-main {
  flex: 1;
  min-width: 0;
}

.banner-main .banner-text {
  display: block;
  flex: 0 0 auto;
}

.banner-sub {
  display: block;
  margin-top: 4rpx;
  color: var(--accent);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.banner-text {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.banner-btn {
  flex: 0 0 auto;
  margin-left: 16rpx;
  padding: 8rpx 22rpx;
  border: 2rpx dashed var(--accent);
  border-radius: 999rpx;
  color: var(--accent);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

/* ---------- 菜卡 ---------- */
.card {
  margin-bottom: 30rpx;
  padding: 24rpx;
}

.dish-head {
  display: flex;
  align-items: center;
}

.thumb {
  flex: 0 0 120rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: rgba(234, 223, 203, 0.45);
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.thumb-blank {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.thumb-mark {
  color: var(--ink-soft);
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.dish-info {
  flex: 1;
  min-width: 0;
  margin: 0 18rpx;
}

.dish-name {
  display: block;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-count {
  display: block;
  margin-top: 6rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.want-btn {
  flex: 0 0 auto;
  padding: 10rpx 22rpx;
  border: 2rpx dashed var(--sage);
  border-radius: 999rpx;
  color: var(--sage);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.want-on {
  border-style: solid;
  background-color: rgba(124, 154, 109, 0.18);
  color: var(--sage);
  font-weight: 600;
}

.is-busy {
  opacity: 0.5;
}

/* ---------- 点菜人 ---------- */
.orders {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed var(--line);
}

.order-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.row-avatar {
  flex: 0 0 56rpx;
  width: 56rpx;
  height: 56rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background-color: rgba(234, 223, 203, 0.75);
}

.row-avatar-blank {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background-color: var(--accent-soft);
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 600;
}

.row-body {
  flex: 1;
  min-width: 0;
}

.row-line {
  display: flex;
  align-items: baseline;
}

.row-name {
  flex: 0 1 auto;
  min-width: 0;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-time {
  flex: 0 0 auto;
  margin-left: 14rpx;
  color: var(--ink-soft);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.row-note {
  display: block;
  margin-top: 4rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
  line-height: 1.5;
}

.cancel-btn {
  flex: 0 0 auto;
  margin-left: 16rpx;
  padding: 6rpx 16rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
  letter-spacing: 1rpx;
  text-decoration: underline;
}

/* ---------- 想吃：只显示头像 ---------- */
.wants {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 2rpx dashed var(--line);
}

.wants-label {
  flex: 0 0 auto;
  margin-right: 16rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.wants-avatars {
  display: flex;
  flex-wrap: wrap;
  flex: 1;
  min-width: 0;
}

.want-avatar {
  width: 48rpx;
  height: 48rpx;
  margin: 0 12rpx 8rpx 0;
  border-radius: 50%;
  background-color: rgba(234, 223, 203, 0.75);
}

.want-avatar-blank {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background-color: rgba(124, 154, 109, 0.22);
  color: var(--sage);
  font-size: 22rpx;
  font-weight: 600;
}

/* 点头像后的那一行小字：淡入，2 秒后由 js 清掉 */
@keyframes wantTipIn {
  from {
    opacity: 0;
    transform: translateY(-6rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.want-tip {
  margin-top: 10rpx;
  color: var(--sage);
  font-size: 22rpx;
  letter-spacing: 1rpx;
  animation: wantTipIn 240ms ease;
}

/* ---------- 空状态 ---------- */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 28rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.empty-hint {
  margin-top: 12rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

/* ---------- 历史入口 ---------- */
.history-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  padding: 22rpx 0;
  border-top: 2rpx dashed var(--line);
}

.history-text {
  color: var(--ink-soft);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.history-arrow {
  margin-left: 10rpx;
  color: var(--ink-soft);
  font-size: 28rpx;
}

/* ============================================================
   浮层（挂在页面根节点下，见 menu.wxml 的说明）
   z-index 880：盖住悬浮球(800)，仍低于引导浮层(900)
   ============================================================ */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 880;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background-color: rgba(59, 48, 42, 0.42);
}

.sheet {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 100%;
  max-height: 82vh;
  padding: 26rpx 28rpx 20rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-radius: var(--radius) var(--radius) 0 0;
  background-color: var(--paper);
  box-shadow: 0 -8rpx 28rpx rgba(90, 62, 40, 0.16);
}

.sheet-title {
  margin-bottom: 18rpx;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-align: center;
}

.sheet-body {
  flex: 1;
  min-height: 0;
  max-height: 60vh;
}

.sheet-hint {
  padding: 40rpx 0;
  color: var(--ink-soft);
  font-size: 24rpx;
  text-align: center;
  letter-spacing: 1rpx;
}

.sheet-foot {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed var(--line);
}

.btn-ghost {
  flex: 0 0 auto;
  padding: 20rpx 40rpx;
  border: 2rpx dashed var(--line);
  border-radius: var(--radius);
  color: var(--ink-soft);
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

.btn-main {
  flex: 1;
  margin-left: 20rpx;
  padding: 20rpx 40rpx;
  border-radius: var(--radius);
  background-color: var(--accent);
  box-shadow: var(--shadow);
  color: var(--card);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-align: center;
}

/* ---------- 表单 ---------- */
.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 2rpx dashed var(--line);
}

.field-row {
  align-items: center;
}

.field-label {
  flex: 0 0 auto;
  color: var(--ink);
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

.field-input {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  padding: 10rpx 18rpx;
  border: 2rpx dashed var(--line);
  border-radius: 16rpx;
  background-color: var(--card);
  color: var(--ink);
  font-size: 26rpx;
  text-align: right;
}

.field-placeholder {
  color: var(--ink-soft);
}

.field-picker {
  padding: 10rpx 22rpx;
  border: 2rpx dashed var(--line);
  border-radius: 16rpx;
  background-color: var(--card);
  color: var(--ink);
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.chip {
  margin: 6rpx 0 6rpx 12rpx;
  padding: 8rpx 24rpx;
  border: 2rpx dashed var(--line);
  border-radius: 999rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.chip-on {
  border-color: var(--accent);
  border-style: solid;
  background-color: var(--accent-soft);
  color: var(--ink);
  font-weight: 600;
}

/* ---------- 历史列表 ---------- */
.his-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 22rpx;
  margin-bottom: 18rpx;
  border-radius: var(--radius);
  background-color: var(--card);
  box-shadow: var(--shadow);
}

.his-main {
  flex: 1;
  min-width: 0;
}

.his-title {
  display: block;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.his-meta {
  display: block;
  margin-top: 6rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.his-count {
  display: block;
  margin-top: 4rpx;
  color: var(--sage);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.his-status {
  flex: 0 0 auto;
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background-color: rgba(138, 123, 109, 0.12);
  color: var(--ink-soft);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.his-more {
  padding: 22rpx 0;
  color: var(--ink-soft);
  font-size: 24rpx;
  text-align: center;
  letter-spacing: 1rpx;
}
