/* 点菜记录页（非 tab 页，底部不需要给 tabBar 留空）
 * 只允许 var(--x) 与 rgba()，不出现颜色字面量。
 */

.orders-page {
  padding-bottom: 120rpx;
}

.orders-page .page-head {
  margin-bottom: 20rpx;
}

/* ---------- 待处理计数 ---------- */
.count-bar {
  display: flex;
  align-items: baseline;
  margin-bottom: 24rpx;
  padding: 22rpx 28rpx;
}

.count-num {
  color: var(--accent);
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.count-text {
  margin-left: 12rpx;
  color: var(--ink);
  font-size: 26rpx;
}

.count-total {
  margin-left: auto;
  color: var(--ink-soft);
  font-size: 22rpx;
}

/* ---------- 筛选 ---------- */
.filters {
  display: flex;
  margin-bottom: 24rpx;
}

.filter {
  margin-right: 16rpx;
  padding: 12rpx 30rpx;
  border: 2rpx dashed var(--line);
  border-radius: 999rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.filter-on {
  border-color: var(--accent);
  background-color: var(--accent-soft);
  color: var(--ink);
  font-weight: 600;
}

/* ---------- 记录卡片 ---------- */
.card {
  margin-bottom: 28rpx;
  padding: 24rpx;
}

.card-main {
  display: flex;
}

.thumb {
  flex: 0 0 150rpx;
  width: 150rpx;
  height: 150rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background-color: rgba(234, 223, 203, 0.45);
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.thumb-blank {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.thumb-mark {
  color: var(--ink-soft);
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.card-body {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dish-name {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status {
  flex: 0 0 auto;
  margin-left: 14rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.status-new {
  background-color: rgba(232, 180, 74, 0.26);
  color: var(--ink);
}

.status-done {
  background-color: rgba(124, 154, 109, 0.20);
  color: var(--sage);
}

.card-meta {
  margin-top: 10rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
}

.who {
  color: var(--ink);
  font-weight: 600;
}

.dot {
  margin: 0 10rpx;
}

.note {
  margin-top: 12rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  line-height: 1.5;
}

.card-foot {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx dashed var(--line);
}

.done-btn {
  padding: 10rpx 32rpx;
  border-radius: 999rpx;
  background-color: var(--sage);
  color: var(--card);
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.is-busy {
  background-color: var(--ink-soft);
  opacity: 0.6;
}

.done-note {
  color: var(--ink-soft);
  font-size: 22rpx;
}

/* ---------- 骨架 ---------- */
.skeleton-cover {
  width: 150rpx;
  height: 150rpx;
  margin-bottom: 20rpx;
}

.skeleton-title {
  width: 60%;
}

.skeleton-sub {
  width: 40%;
  margin-bottom: 0;
}

/* ---------- 底部提示 ---------- */
.foot-hint {
  padding: 20rpx 0 40rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
  text-align: center;
  letter-spacing: 1rpx;
}
