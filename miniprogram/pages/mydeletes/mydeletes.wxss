/* 我的申请（非 tab 页，底部不需要给 tabBar 留空）
 * 只允许 var(--x) 与 rgba()，不出现颜色字面量。
 */

.mydeletes-page {
  padding-bottom: 120rpx;
}

.mydeletes-page .page-head {
  margin-bottom: 20rpx;
}

/* ---------- 分类切换 ---------- */
.mode-bar {
  display: flex;
  margin-bottom: 24rpx;
}

.mode-chip {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin-right: 14rpx;
  padding: 16rpx 12rpx;
  border: 2rpx dashed var(--line);
  border-radius: 999rpx;
  background-color: rgba(255, 253, 248, 0.55);
}

.mode-chip:last-child {
  margin-right: 0;
}

/* 选中态：暖橙虚线 + 浅橙底，不用系统高亮 */
.mode-chip.is-on {
  border-color: var(--accent);
  background-color: var(--accent-soft);
}

.mode-text {
  color: var(--ink-soft);
  font-size: 24rpx;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.mode-chip.is-on .mode-text {
  color: var(--ink);
  font-weight: 600;
}

.mode-num {
  min-width: 30rpx;
  margin-left: 8rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background-color: rgba(90, 62, 40, 0.10);
  color: var(--ink-soft);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 32rpx;
  text-align: center;
}

.mode-chip.is-on .mode-num {
  background-color: var(--accent);
  color: var(--card);
}

/* ---------- 申请卡片 ---------- */
.card {
  margin-bottom: 24rpx;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dish-name {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 类型徽标：删除 / 修改用不同色系区分 */
.type-badge {
  flex: 0 0 auto;
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.type-delete {
  background-color: rgba(228, 100, 60, 0.14);
  color: var(--accent);
}

.type-edit {
  background-color: rgba(90, 62, 40, 0.08);
  color: var(--ink-soft);
}

.card-meta {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

/* 状态徽标：待审核 mustard 系 / 已通过 sage 系 / 未通过 ink-soft 系 */
.status-badge {
  flex: 0 0 auto;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.status-pending {
  background-color: rgba(232, 180, 74, 0.26);
  color: var(--ink);
}

.status-approved {
  background-color: rgba(124, 154, 109, 0.20);
  color: var(--sage);
}

.status-rejected {
  background-color: rgba(138, 123, 109, 0.14);
  color: var(--ink-soft);
}

.dot {
  margin: 0 10rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
}

.time {
  color: var(--ink-soft);
  font-size: 22rpx;
}

/* 删除理由：小字，弱化处理 */
.reason {
  margin-top: 12rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
  line-height: 1.5;
}

.reviewed {
  margin-top: 6rpx;
  color: var(--ink-soft);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

/* ---------- 骨架 ---------- */
.skeleton-title {
  width: 55%;
}

.skeleton-sub {
  width: 38%;
}

.skeleton-sub:last-child {
  margin-bottom: 0;
}

/* ---------- 底部提示 ---------- */
.foot-hint {
  padding: 16rpx 0 40rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
  text-align: center;
  letter-spacing: 1rpx;
}
